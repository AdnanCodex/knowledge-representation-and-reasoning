<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/krr/university"
         xmlns="http://example.org/krr/university#">

<owl:Ontology rdf:about="http://example.org/krr/university"/>

<owl:ObjectProperty rdf:about="#enrolledIn">
  <rdfs:domain rdf:resource="#Student"/>
  <rdfs:range rdf:resource="#Course"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#teaches">
  <rdfs:domain rdf:resource="#Professor"/>
  <rdfs:range rdf:resource="#Course"/>
  <owl:inverseOf rdf:resource="#taughtBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#taughtBy">
  <owl:inverseOf rdf:resource="#teaches"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#memberOf">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Department"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCredits">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Student">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#Professor">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#Course">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Department">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#EnrolledStudent">
  <rdfs:subClassOf rdf:resource="#Student"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Student"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#enrolledIn"/>
          <owl:someValuesFrom rdf:resource="#Course"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#BusyStudent">
  <rdfs:subClassOf rdf:resource="#Student"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Student"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#enrolledIn"/>
          <owl:onClass rdf:resource="#Course"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="#computer_science">
  <rdf:type rdf:resource="#Department"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#krr_cs331">
  <rdf:type rdf:resource="#Course"/>
  <hasCredits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasCredits>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#intro_ai">
  <rdf:type rdf:resource="#Course"/>
  <hasCredits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasCredits>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ali">
  <rdf:type rdf:resource="#Student"/>
  <enrolledIn rdf:resource="#krr_cs331"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ali</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#sara">
  <rdf:type rdf:resource="#Student"/>
  <enrolledIn rdf:resource="#krr_cs331"/>
  <enrolledIn rdf:resource="#intro_ai"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sara</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#bilal">
  <rdf:type rdf:resource="#Student"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bilal</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#dr_fatima">
  <rdf:type rdf:resource="#Professor"/>
  <teaches rdf:resource="#krr_cs331"/>
  <memberOf rdf:resource="#computer_science"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dr. Fatima</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#zoya">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <enrolledIn rdf:resource="#intro_ai"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zoya</hasName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#dr_khan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <teaches rdf:resource="#intro_ai"/>
  <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dr. Khan</hasName>
</owl:NamedIndividual>

<owl:AllDifferent>
  <owl:distinctMembers rdf:parseType="Collection">
    <rdf:Description rdf:about="#ali"/>
    <rdf:Description rdf:about="#sara"/>
    <rdf:Description rdf:about="#bilal"/>
    <rdf:Description rdf:about="#dr_fatima"/>
    <rdf:Description rdf:about="#zoya"/>
    <rdf:Description rdf:about="#dr_khan"/>
  </owl:distinctMembers>
</owl:AllDifferent>

<owl:AllDifferent>
  <owl:distinctMembers rdf:parseType="Collection">
    <rdf:Description rdf:about="#krr_cs331"/>
    <rdf:Description rdf:about="#intro_ai"/>
  </owl:distinctMembers>
</owl:AllDifferent>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Student"/>
    <rdf:Description rdf:about="#Professor"/>
    <rdf:Description rdf:about="#Course"/>
    <rdf:Description rdf:about="#Department"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
